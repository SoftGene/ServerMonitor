<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-ServerMonitor.Agent-52b04953-e3d7-487d-a060-aeebc8cd2113</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServerMonitor.Collection\ServerMonitor.Collection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Development settings are for dotnet run on a developer's machine. Published, they would ship
         to every watched machine and take effect the moment anyone there set DOTNET_ENVIRONMENT. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
