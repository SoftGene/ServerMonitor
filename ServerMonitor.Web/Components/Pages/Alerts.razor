@page "/alerts"
@page "/servers/{PublicId:guid}/alerts"
@attribute [Authorize]
@using ServerMonitor.Web.Models
@using ServerMonitor.Web.Services
@inject MetricsApiClient ApiClient

<PageTitle>Alerts · ServerML</PageTitle>

<div class="alerts-page">
    <header class="page-header">
        <div>
            @if (PublicId is not null)
            {
                <a class="back-link" href="@($"servers/{PublicId}")">← @(serverName ?? "Server")</a>
            }
            <h1>Alerts</h1>
            <p class="page-sub">
                @(PublicId is null ? "Alert history across the whole fleet" : "Alert history for this machine")
            </p>
        </div>
        <button class="refresh-btn @(isRefreshing ? "spinning" : "")" @onclick="Refresh" title="Refresh">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6M1 20v-6h6" /><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15" /></svg>
        </button>
    </header>

    @if (loadError is not null)
    {
        <div class="state-msg error">⚠ @loadError</div>
    }
    else if (alerts is null)
    {
        <div class="state-msg">Loading...</div>
    }
    else if (alerts.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">OK</div>
            <h3>No alerts yet</h3>
            <p>Everything is running smoothly. Events appear here when a threshold is crossed or a machine stops reporting.</p>
        </div>
    }
    else
    {
        <div class="section-label"><span class="section-no">01</span>Event log</div>
        <div class="alerts-list">
            @foreach (var alert in alerts)
            {
                <div class="alert-item @ItemClass(alert)">
                    <div class="alert-icon">
                        @if (alert.MetricType == "Availability")
                        {
                            @* A missing machine is not a threshold breach, and the icon has to say so. *@
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6" /><path d="M18.4 6.6a9 9 0 11-12.8 0" /></svg>
                        }
                        else if (alert.AlertType == "Triggered")
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" /><path d="M12 9v4M12 17h.01" /></svg>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14" /><path d="M22 4L12 14.01l-3-3" /></svg>
                        }
                    </div>
                    <div class="alert-body">
                        <div class="alert-title">
                            @* In a shared list the machine is mandatory: without it the event is addressed to nothing. *@
                            @if (PublicId is null)
                            {
                                <a class="alert-server" href="@($"servers/{alert.ServerPublicId}")">@alert.ServerName</a>
                                <span class="alert-sep">·</span>
                            }
                            @Title(alert)
                        </div>
                        <div class="alert-detail">
                            @Detail(alert)
                        </div>
                    </div>
                    <div class="alert-time">
                        @alert.TimestampUtc.ToLocalTime().ToString("dd MMM, HH:mm:ss")
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>
    /// The machine, when one machine's list is open. null means the fleet-wide list: the
    /// question "where did something break" is about all of them at once.
    /// </summary>
    [Parameter]
    public Guid? PublicId { get; set; }

    private List<Alert>? alerts;
    private string? serverName;
    private Guid? loadedId;
    private bool hasLoaded;
    private string? loadError;
    private bool isRefreshing = false;

    protected override async Task OnParametersSetAsync()
    {
        if (hasLoaded && loadedId == PublicId)
        {
            return;
        }

        hasLoaded = true;
        loadedId = PublicId;
        alerts = null;

        serverName = PublicId is null
            ? null
            : (await ApiClient.GetServerAsync(PublicId.Value))?.Name;

        await LoadAlerts();
    }

    private async Task LoadAlerts()
    {
        try
        {
            alerts = await ApiClient.GetAlertsAsync(50, PublicId);
            loadError = null;
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    /// <summary>
    /// Warnings get their own colour. Painting every triggered event the same red is how a list
    /// teaches its reader to stop telling them apart — and then the critical one gets missed.
    /// </summary>
    private static string ItemClass(Alert alert) => alert.AlertType switch
    {
        "Recovered" => "recovered",
        _ when alert.Severity == "Warning" => "triggered warning",
        _ => "triggered"
    };

    /// <summary>
    /// An availability event reads differently from a threshold breach: "CPU critical" and
    /// "machine stopped reporting" mean different things, and identical phrasing would mislead.
    /// </summary>
    private static string Title(Alert alert) => alert.MetricType switch
    {
        "Availability" => alert.AlertType == "Triggered"
            ? "stopped reporting"
            : "is reporting again",
        _ when alert.AlertType == "Recovered" => $"{alert.MetricType} back to normal",
        _ => $"{alert.MetricType} {(alert.Severity == "Warning" ? "warning" : "critical")}"
    };

    private static string Detail(Alert alert) => alert.MetricType switch
    {
        "Availability" => alert.AlertType == "Triggered"
            ? $"Silent for {alert.Value:0.#} min · threshold {alert.Threshold:0.#} min"
            : $"Back after {alert.Value:0.#} min of silence",
        _ when alert.AlertType == "Recovered" => $"Value: {alert.Value}% · below {alert.Threshold}%",
        _ => $"Value: {alert.Value}% · {(alert.Severity == "Warning" ? "warning" : "critical")} threshold: {alert.Threshold}%"
    };

    private async Task Refresh()
    {
        isRefreshing = true;
        StateHasChanged();
        await LoadAlerts();
        await Task.Delay(500);
        isRefreshing = false;
    }
}