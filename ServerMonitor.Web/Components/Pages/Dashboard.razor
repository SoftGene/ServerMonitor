@page "/servers/{PublicId:guid}"
@attribute [Authorize]
@using System.Globalization
@using ServerMonitor.Web.Models
@using ServerMonitor.Web.Services
@using ServerMonitor.Web.Components.Shared
@using ServerMonitor.Web.Presentation
@using Microsoft.AspNetCore.Components.Web
@inject MetricsApiClient ApiClient
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Server Monitor</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <div>
            <a class="back-link" href="">← Fleet</a>
            @if (isRenaming)
            {
                <div class="rename-row">
                    <input class="rename-input" @bind="draftName" @bind:event="oninput"
                           @onkeydown="OnRenameKeyDown" maxlength="60" autofocus
                           aria-label="Machine name" />
                    <button class="rename-ok" @onclick="SaveNameAsync" disabled="@(!CanSaveName)">Save</button>
                    <button class="rename-cancel" @onclick="CancelRename">Cancel</button>
                </div>
                @if (renameError is not null)
                {
                    <p class="rename-error">@renameError</p>
                }
            }
            else
            {
                <h1 class="machine-name">
                    @(server?.Name ?? "Server")
                    @if (server is not null)
                    {
                        <button class="rename-btn" @onclick="StartRename" title="Rename this machine" aria-label="Rename this machine">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4z" /></svg>
                        </button>
                    }
                </h1>
            }
            @if (status is not null)
            {
                <p class="dash-subtitle">
                    <span class="live-dot @MachineState.DotClass(server?.Health)"></span>
                    @MachineState.Label(server?.Health) · @Freshness@(isPaused ? " · paused" : "")<span class="term-cursor" aria-hidden="true"></span>
                </p>
            }
        </div>
        <div class="header-actions">
            <div class="cube-wrap" title="@MachineState.Label(server?.Health)" aria-hidden="true">
                <div class="cube @(IsFlowing ? "" : "paused")">
                    <span class="cf cf-1"></span><span class="cf cf-2"></span><span class="cf cf-3"></span>
                    <span class="cf cf-4"></span><span class="cf cf-5"></span><span class="cf cf-6"></span>
                </div>
            </div>
            <button class="icon-btn @(isRefreshing ? "spinning" : "")" @onclick="RefreshNow" title="Refresh now">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6M1 20v-6h6" /><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15" /></svg>
            </button>
            <button class="icon-btn" @onclick="TogglePause" title="@(isPaused ? "Resume" : "Pause")">
                @if (isPaused)
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                }
                else
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4h4v16H6zM14 4h4v16h-4z" /></svg>
                }
            </button>
        </div>
    </header>

    @if (loadError is not null)
    {
        <div class="state-msg error">[ERR] @loadError</div>
    }
    else if (!hasLoaded)
    {
        <div class="state-msg">Loading…</div>
    }
    else if (server is null)
    {
        <div class="state-msg error">[ERR] This server no longer exists.</div>
    }
    else if (status is null)
    {
        <div class="state-msg">No readings from this machine yet. The agent registers before it sends its first sample.</div>
    }
    else
    {
        <div class="section-label"><span class="section-no">01</span>Live metrics</div>
        <div class="metric-panel">
            <MetricCard Title="CPU Usage" Value="@($"{status.CpuUsagePercent}%")" Percent="status.CpuUsagePercent"
                        Subtitle="@StatLine(h => h.CpuUsagePercent)" Icon="@IconCpu"
                        Spark="@ChartPoints(h => h.CpuUsagePercent, 100, 24)" />
            <MetricCard Title="Memory" Value="@($"{status.MemoryUsagePercent}%")" Percent="status.MemoryUsagePercent"
                        Subtitle="@($"{status.MemoryUsedMb:F0} / {status.MemoryTotalMb:F0} MB")" Icon="@IconMemory"
                        Spark="@ChartPoints(h => h.MemoryUsagePercent, 100, 24)" />
            <MetricCard Title="Disk" Value="@($"{status.DiskUsagePercent}%")" Percent="status.DiskUsagePercent"
                        Subtitle="@($"{status.DiskUsedGb:F1} / {status.DiskTotalGb:F1} GB")" Icon="@IconDisk"
                        Spark="@ChartPoints(h => h.DiskUsagePercent, 100, 24)" />
            <MetricCard Title="Uptime" Value="@status.Uptime" Icon="@IconClock" />
        </div>

        <div class="chart-panel">
            <div class="chart-header">
                <div class="section-label no-rule"><span class="section-no">02</span>Performance history</div>
                <div class="period-switch">
                    @foreach (var p in periods)
                    {
                        <button class="period-btn @(sampleCount == p ? "active" : "")" @onclick="() => ChangePeriod(p)">@p</button>
                    }
                </div>
            </div>
            @if (history.Count > 1)
            {
                <div class="scope-stack">
                    <div class="scope-channel ch-cpu">
                        <div class="scope-meta">
                            <span class="ch-id">CH1</span>
                            <span class="ch-name">CPU</span>
                            <span class="ch-val">@status.CpuUsagePercent%</span>
                        </div>
                        <div class="scope-view">
                            <svg viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true">
                                <line class="scope-grid" x1="0" y1="8" x2="100" y2="8" vector-effect="non-scaling-stroke" />
                                <line class="scope-grid" x1="0" y1="16" x2="100" y2="16" vector-effect="non-scaling-stroke" />
                                <line class="scope-grid" x1="0" y1="24" x2="100" y2="24" vector-effect="non-scaling-stroke" />
                                <line class="scope-grid v" x1="25" y1="0" x2="25" y2="32" vector-effect="non-scaling-stroke" />
                                <line class="scope-grid v" x1="50" y1="0" x2="50" y2="32" vector-effect="non-scaling-stroke" />
                                <line class="scope-grid v" x1="75" y1="0" x2="75" y2="32" vector-effect="non-scaling-stroke" />
                                <polygon class="scope-fill" points="0,32 @ChartPoints(h => h.CpuUsagePercent) 100,32" />
                                <polyline class="scope-line" points="@ChartPoints(h => h.CpuUsagePercent)" vector-effect="non-scaling-stroke" />
                            </svg>
                        </div>
                    </div>
                    <div class="scope-channel ch-mem">
                        <div class="scope-meta">
                            <span class="ch-id">CH2</span>
                            <span class="ch-name">MEM</span>
                            <span class="ch-val">@status.MemoryUsagePercent%</span>
                        </div>
                        <div class="scope-view">
                            <svg viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true">
                                <line class="scope-grid" x1="0" y1="8" x2="100" y2="8" vector-effect="non-scaling-stroke" />
                                <line class="scope-grid" x1="0" y1="16" x2="100" y2="16" vector-effect="non-scaling-stroke" />
                                <line class="scope-grid" x1="0" y1="24" x2="100" y2="24" vector-effect="non-scaling-stroke" />
                                <line class="scope-grid v" x1="25" y1="0" x2="25" y2="32" vector-effect="non-scaling-stroke" />
                                <line class="scope-grid v" x1="50" y1="0" x2="50" y2="32" vector-effect="non-scaling-stroke" />
                                <line class="scope-grid v" x1="75" y1="0" x2="75" y2="32" vector-effect="non-scaling-stroke" />
                                <polygon class="scope-fill" points="0,32 @ChartPoints(h => h.MemoryUsagePercent) 100,32" />
                                <polyline class="scope-line" points="@ChartPoints(h => h.MemoryUsagePercent)" vector-effect="non-scaling-stroke" />
                            </svg>
                        </div>
                    </div>
                    <div class="scope-channel ch-disk">
                        <div class="scope-meta">
                            <span class="ch-id">CH3</span>
                            <span class="ch-name">DISK</span>
                            <span class="ch-val">@status.DiskUsagePercent%</span>
                        </div>
                        <div class="scope-view">
                            <svg viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true">
                                <line class="scope-grid" x1="0" y1="8" x2="100" y2="8" vector-effect="non-scaling-stroke" />
                                <line class="scope-grid" x1="0" y1="16" x2="100" y2="16" vector-effect="non-scaling-stroke" />
                                <line class="scope-grid" x1="0" y1="24" x2="100" y2="24" vector-effect="non-scaling-stroke" />
                                <line class="scope-grid v" x1="25" y1="0" x2="25" y2="32" vector-effect="non-scaling-stroke" />
                                <line class="scope-grid v" x1="50" y1="0" x2="50" y2="32" vector-effect="non-scaling-stroke" />
                                <line class="scope-grid v" x1="75" y1="0" x2="75" y2="32" vector-effect="non-scaling-stroke" />
                                <polygon class="scope-fill" points="0,32 @ChartPoints(h => h.DiskUsagePercent) 100,32" />
                                <polyline class="scope-line" points="@ChartPoints(h => h.DiskUsagePercent)" vector-effect="non-scaling-stroke" />
                            </svg>
                        </div>
                    </div>
                    <div class="scope-time">
                        <span>@history[0].TimestampUtc.ToString("HH:mm")</span>
                        <span>@history[history.Count - 1].TimestampUtc.ToString("HH:mm")</span>
                    </div>
                </div>
            }
            else
            {
                <div class="scope-empty">Collecting samples…</div>
            }
        </div>

        @if (history.Count > 0)
        {
            <div class="stats-section">
                <div class="section-label"><span class="section-no">03</span>Session stats</div>
                <div class="stats-strip">
                    <div class="stat">
                        <span class="stat-k">CPU AVG</span>
                        <span class="stat-v">@history.Average(h => h.CpuUsagePercent).ToString("F1")%</span>
                    </div>
                    <div class="stat">
                        <span class="stat-k">CPU MAX</span>
                        <span class="stat-v">@history.Max(h => h.CpuUsagePercent).ToString("F1")%</span>
                    </div>
                    <div class="stat">
                        <span class="stat-k">MEM AVG</span>
                        <span class="stat-v">@history.Average(h => h.MemoryUsagePercent).ToString("F1")%</span>
                    </div>
                    <div class="stat">
                        <span class="stat-k">MEM MAX</span>
                        <span class="stat-v">@history.Max(h => h.MemoryUsagePercent).ToString("F1")%</span>
                    </div>
                    <div class="stat">
                        <span class="stat-k">DISK AVG</span>
                        <span class="stat-v">@history.Average(h => h.DiskUsagePercent).ToString("F1")%</span>
                    </div>
                    <div class="stat">
                        <span class="stat-k">DISK MAX</span>
                        <span class="stat-v">@history.Max(h => h.DiskUsagePercent).ToString("F1")%</span>
                    </div>
                    <div class="stat">
                        <span class="stat-k">SAMPLES</span>
                        <span class="stat-v">@history.Count</span>
                    </div>
                    <div class="stat">
                        <span class="stat-k">UPTIME</span>
                        <span class="stat-v">@status.Uptime</span>
                    </div>
                </div>
            </div>
        }
    }

    @if (server is not null)
    {
        <div class="section-label"><span class="section-no">04</span>Availability</div>
        <div class="availability-card">
            <div class="availability-text">
                <div class="availability-title">Report as missing after</div>
                <p class="availability-desc">
                    @if (server.CustomOfflineAfterSeconds is null)
                    {
                        <text>Follows the fleet default of <strong>@FormatDuration(server.FleetOfflineAfterSeconds)</strong>.
                        Give this machine its own if it is expected to go quiet — a laptop that sleeps at
                        night should not raise an alarm every evening.</text>
                    }
                    else
                    {
                        <text>This machine has its own threshold of <strong>@FormatDuration(server.CustomOfflineAfterSeconds.Value)</strong>;
                        the fleet default is @FormatDuration(server.FleetOfflineAfterSeconds).</text>
                    }
                </p>
            </div>
            <div class="availability-controls">
                <div class="minutes-wrap">
                    <input type="number" min="1" max="1440" class="minutes-input"
                           @bind="thresholdMinutes" aria-label="Minutes of silence" />
                    <span class="minutes-unit">min</span>
                </div>
                <button class="availability-btn" @onclick="SaveThresholdAsync">Save</button>
                @if (server.CustomOfflineAfterSeconds is not null)
                {
                    <button class="cancel-btn" @onclick="UseFleetDefaultAsync">Use fleet default</button>
                }
            </div>
        </div>
        @if (thresholdMessage is not null)
        {
            <div class="state-msg @(thresholdSaved ? "" : "error")">@thresholdMessage</div>
        }

        <div class="section-label"><span class="section-no">05</span>Danger zone</div>
        <div class="danger-zone">
            <div class="danger-text">
                <div class="danger-title">Remove this machine</div>
                <p class="danger-desc">
                    Deletes <strong>@server.Name</strong> together with every stored sample and alert.
                    This cannot be undone.
                </p>
            </div>
            @if (!isDeleting)
            {
                <button class="danger-btn" @onclick="StartDelete">Remove…</button>
            }
        </div>

        @if (isDeleting)
        {
            <div class="danger-confirm">
                @* Confirmation by typing the name, proportionate to the damage: a month of
                   history should not disappear to one stray click. *@
                <label for="confirmName">Type <code>@server.Name</code> to confirm.</label>
                <div class="confirm-row">
                    <input id="confirmName" class="confirm-input" autocomplete="off"
                           placeholder="@server.Name"
                           value="@confirmName" @oninput="OnConfirmNameInput" />
                    <button class="danger-btn" disabled="@(confirmName != server.Name)" @onclick="DeleteServerAsync">
                        Delete permanently
                    </button>
                    <button class="cancel-btn" @onclick="CancelDelete">Cancel</button>
                </div>
                @if (deleteError is not null)
                {
                    <div class="state-msg error">[ERR] @deleteError</div>
                }
            </div>
        }
    }
</div>

@code {
    /// <summary>The machine whose dashboard is open. Comes from the /servers/{guid} address.</summary>
    [Parameter]
    public Guid PublicId { get; set; }

    private ServerSummary? server;
    private ServerStatus? status;
    private List<MetricHistoryItem> history = new();
    private string? loadError;
    private Timer? refreshTimer;
    private Guid loadedId;
    private bool hasLoaded;

    private bool isPaused = false;
    private bool isRefreshing = false;
    private int sampleCount = 50;
    private readonly int[] periods = { 50, 100, 200 };

    private bool isDeleting;
    private string confirmName = string.Empty;
    private string? deleteError;

    // Not OnInitializedAsync: moving from one machine to another changes only the route
    // parameter, and Blazor reuses the component — initialisation would not run again.
    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == PublicId)
        {
            return;
        }

        loadedId = PublicId;

        // Another machine's readings must not flash up on the new page, so the state is cleared.
        hasLoaded = false;
        server = null;
        status = null;
        history = new();

        await LoadDataAsync();

        refreshTimer ??= new Timer(async _ =>
        {
            if (!isPaused)
            {
                await LoadDataAsync();
                await InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadDataAsync()
    {
        try
        {
            server = await ApiClient.GetServerAsync(PublicId);
            SyncThresholdDraft();

            if (server is null)
            {
                // The machine was deleted — nothing to show, but this is not a connection error.
                status = null;
                history = new();
                loadError = null;

                return;
            }

            status = await ApiClient.GetStatusAsync(PublicId);

            var raw = await ApiClient.GetHistoryAsync(PublicId, sampleCount);
            history = raw
                .OrderBy(h => h.TimestampUtc)
                .Select(h => new MetricHistoryItem
                {
                    TimestampUtc = h.TimestampUtc.ToLocalTime(),
                    CpuUsagePercent = h.CpuUsagePercent,
                    MemoryUsagePercent = h.MemoryUsagePercent,
                    DiskUsagePercent = h.DiskUsagePercent
                })
                .ToList();
            loadError = null;
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            hasLoaded = true;
        }
    }

    private async Task RefreshNow()
    {
        isRefreshing = true;
        StateHasChanged();
        await LoadDataAsync();
        await Task.Delay(500);
        isRefreshing = false;
    }

    private bool isRenaming;
    private string draftName = string.Empty;
    private string? renameError;

    /// <summary>The same rule the API enforces, so the button is not offered for a refusal.</summary>
    private bool CanSaveName => draftName.Trim().Length is > 0 and <= 60;

    private void StartRename()
    {
        draftName = server?.Name ?? string.Empty;
        renameError = null;
        isRenaming = true;
    }

    private void CancelRename()
    {
        isRenaming = false;
        renameError = null;
    }

    private async Task OnRenameKeyDown(KeyboardEventArgs args)
    {
        // Enter saves and Escape abandons, because a one-field form that only responds to the
        // mouse is a small irritation repeated every time.
        if (args.Key == "Enter")
        {
            await SaveNameAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelRename();
        }
    }

    private async Task SaveNameAsync()
    {
        if (server is null || !CanSaveName)
        {
            return;
        }

        var name = draftName.Trim();

        if (name == server.Name)
        {
            CancelRename();

            return;
        }

        renameError = await ApiClient.RenameServerAsync(PublicId, name);

        if (renameError is not null)
        {
            return;
        }

        // Shown at once rather than waiting for the next poll, which is up to five seconds away
        // and would make the rename look like it had not worked.
        server.Name = name;
        isRenaming = false;
    }

    private int thresholdMinutes = 5;
    private Guid? thresholdDraftFor;
    private string? thresholdMessage;
    private bool thresholdSaved;

    /// <summary>
    /// Fills the minutes field from the server once per machine, not on every poll.
    /// </summary>
    /// <remarks>
    /// The page refreshes every few seconds. Re-reading the value on each refresh would overwrite
    /// whatever the person was in the middle of typing.
    /// </remarks>
    private void SyncThresholdDraft()
    {
        if (server is null || thresholdDraftFor == PublicId)
        {
            return;
        }

        thresholdMinutes = ToMinutes(server.CustomOfflineAfterSeconds ?? server.FleetOfflineAfterSeconds);
        thresholdDraftFor = PublicId;
        thresholdMessage = null;
    }

    private async Task SaveThresholdAsync()
    {
        // Held locally: the poll can replace or clear the field while the request is in flight.
        var current = server;

        if (current is null)
        {
            return;
        }

        if (thresholdMinutes is < 1 or > 1440)
        {
            thresholdSaved = false;
            thresholdMessage = "Between 1 minute and 24 hours.";

            return;
        }

        var seconds = thresholdMinutes * 60;
        var problem = await ApiClient.SetOfflineThresholdAsync(PublicId, seconds);

        thresholdSaved = problem is null;
        thresholdMessage = problem ?? $"Saved. This machine counts as missing after {FormatDuration(seconds)} of silence.";

        if (problem is null)
        {
            // Shown at once rather than on the next poll, so the sentence above matches the value.
            current.CustomOfflineAfterSeconds = seconds;
        }
    }

    private async Task UseFleetDefaultAsync()
    {
        var current = server;

        if (current is null)
        {
            return;
        }

        var problem = await ApiClient.SetOfflineThresholdAsync(PublicId, null);

        thresholdSaved = problem is null;
        thresholdMessage = problem ?? "This machine follows the fleet default again.";

        if (problem is null)
        {
            current.CustomOfflineAfterSeconds = null;
            thresholdMinutes = ToMinutes(current.FleetOfflineAfterSeconds);
        }
    }

    private static int ToMinutes(int seconds) => Math.Max(1, seconds / 60);

    private static string FormatDuration(int seconds) => seconds switch
    {
        < 3600 => $"{Math.Max(1, seconds / 60)} min",
        _ when seconds % 3600 == 0 => $"{seconds / 3600} h",
        _ => $"{seconds / 3600} h {seconds % 3600 / 60} min"
    };

    private void TogglePause() => isPaused = !isPaused;

    /// <summary>Readings are actually arriving: the machine is healthy and the page is polling.</summary>
    private bool IsFlowing => !isPaused && MachineState.IsReporting(server?.Health);

    /// <summary>
    /// How current the numbers on screen are.
    /// </summary>
    /// <remarks>
    /// A clock time is only meaningful while data keeps arriving. For a machine that has stopped,
    /// "upd 18:12" invites the reader to assume it means today — so an age is shown instead, which
    /// cannot be misread.
    /// </remarks>
    private string Freshness => MachineState.IsReporting(server?.Health)
        ? $"upd {status!.TimeStampUtc.ToLocalTime():HH:mm:ss}"
        : $"last seen {MachineState.LastSeen(server?.LastSeenUtc, DateTime.UtcNow)}";

    private void StartDelete() => isDeleting = true;

    private void OnConfirmNameInput(ChangeEventArgs e) => confirmName = e.Value?.ToString() ?? string.Empty;

    private void CancelDelete()
    {
        isDeleting = false;
        confirmName = string.Empty;
        deleteError = null;
    }

    private async Task DeleteServerAsync()
    {
        // The button is disabled anyway, but the check is repeated: the state may have
        // changed between the render and the click.
        if (server is null || confirmName != server.Name)
        {
            return;
        }

        try
        {
            if (await ApiClient.DeleteServerAsync(PublicId))
            {
                Nav.NavigateTo("");

                return;
            }

            deleteError = "The server could not be deleted.";
        }
        catch (Exception ex)
        {
            deleteError = ex.Message;
        }
    }

    private async Task ChangePeriod(int count)
    {
        sampleCount = count;
        await LoadDataAsync();
    }

    private string StatLine(Func<MetricHistoryItem, double> selector)
    {
        if (history.Count == 0) return "";
        var avg = history.Average(selector);
        var max = history.Max(selector);
        return $"avg {avg:F1}% · max {max:F1}%";
    }

    // Points for the SVG charts. Invariant format: CSS and SVG require a dot as the separator.
    private string ChartPoints(Func<MetricHistoryItem, double> selector, double width = 100, double height = 32)
    {
        if (history.Count < 2) return "";
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < history.Count; i++)
        {
            var x = i * width / (history.Count - 1);
            var y = height - Math.Clamp(selector(history[i]), 0, 100) * height / 100.0;
            if (i > 0) sb.Append(' ');
            sb.Append(x.ToString("0.##", CultureInfo.InvariantCulture));
            sb.Append(',');
            sb.Append(y.ToString("0.##", CultureInfo.InvariantCulture));
        }
        return sb.ToString();
    }

