@page "/settings"
@attribute [Authorize]
@using ServerMonitor.Web.Models
@using ServerMonitor.Web.Services
@inject MetricsApiClient ApiClient
@inject AuthApiClient AuthClient

<PageTitle>Settings · ServerML</PageTitle>

<div class="settings-page">
    <header class="page-header">
        <div>
            <h1>Settings</h1>
            <p class="page-sub">Configure alert thresholds and notifications</p>
        </div>
    </header>

    @if (loadError is not null)
    {
        <div class="state-msg error">⚠ @loadError</div>
    }
    else if (settings is null)
    {
        <div class="state-msg">Loading...</div>
    }
    else
    {
        <div class="settings-card">
            <div class="setting-section">
                <h2>Alert Thresholds</h2>
                <p class="section-hint">A warning means worth watching; critical means do something (%)</p>

                <div class="setting-row">
                    <label>CPU</label>
                    <div class="threshold-pair">
                        <span class="pair-label warn">warning</span>
                        <div class="input-wrap">
                            <input type="number" min="1" max="100" @bind="settings.CpuWarningThreshold" class="threshold-input" />
                            <span class="unit">%</span>
                        </div>
                        <span class="pair-label crit">critical</span>
                        <div class="input-wrap">
                            <input type="number" min="1" max="100" @bind="settings.CpuThreshold" class="threshold-input" />
                            <span class="unit">%</span>
                        </div>
                    </div>
                </div>
                <div class="setting-row">
                    <label>Memory</label>
                    <div class="threshold-pair">
                        <span class="pair-label warn">warning</span>
                        <div class="input-wrap">
                            <input type="number" min="1" max="100" @bind="settings.MemoryWarningThreshold" class="threshold-input" />
                            <span class="unit">%</span>
                        </div>
                        <span class="pair-label crit">critical</span>
                        <div class="input-wrap">
                            <input type="number" min="1" max="100" @bind="settings.MemoryThreshold" class="threshold-input" />
                            <span class="unit">%</span>
                        </div>
                    </div>
                </div>
                <div class="setting-row">
                    <label>Disk</label>
                    <div class="threshold-pair">
                        <span class="pair-label warn">warning</span>
                        <div class="input-wrap">
                            <input type="number" min="1" max="100" @bind="settings.DiskWarningThreshold" class="threshold-input" />
                            <span class="unit">%</span>
                        </div>
                        <span class="pair-label crit">critical</span>
                        <div class="input-wrap">
                            <input type="number" min="1" max="100" @bind="settings.DiskThreshold" class="threshold-input" />
                            <span class="unit">%</span>
                        </div>
                    </div>
                </div>
                <p class="row-hint">Set a warning equal to its critical threshold to switch warnings off for that metric</p>
            </div>

            <div class="setting-section">
                <h2>Availability</h2>
                <p class="section-hint">Notify when a machine stops reporting</p>

                <div class="setting-row">
                    <div>
                        <label>Report a machine as missing after</label>
                        <p class="row-hint">The fleet screen uses the same threshold</p>
                    </div>
                    <div class="input-wrap">
                        <input type="number" min="1" max="1440" @bind="settings.OfflineAfterMinutes" class="threshold-input" />
                        <span class="unit">min</span>
                    </div>
                </div>
                <div class="setting-row">
                    <div>
                        <label>Enable availability alerts</label>
                        <p class="row-hint">Threshold alerts stay on independently</p>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="settings.HeartbeatAlertsEnabled" />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>

            <div class="setting-section">
                <h2>Notifications</h2>
                <div class="setting-row">
                    <div>
                        <label>Enable alerts</label>
                        <p class="row-hint">Master switch for every rule below and above</p>
                    </div>
                    <label class="switch">
                        <input type="checkbox" @bind="settings.AlertsEnabled" />
                        <span class="slider"></span>
                    </label>
                </div>
            </div>

            <div class="setting-section">
                <h2>Accounts</h2>
                <p class="section-hint">Everyone signs in with their own name and password</p>

                @if (accounts is null)
                {
                    <p class="row-hint">Loading…</p>
                }
                else
                {
                    <div class="account-list">
                        @foreach (var account in accounts)
                        {
                            <div class="account-row">
                                <div>
                                    <span class="account-name">@account.Username</span>
                                    @if (account.Username == CurrentUser)
                                    {
                                        <span class="account-tag">you</span>
                                    }
                                    <div class="row-hint">
                                        @(account.LastLoginUtc is null
                                            ? "never signed in"
                                            : $"last seen {account.LastLoginUtc.Value.ToLocalTime():dd MMM, HH:mm}")
                                    </div>
                                </div>
                                @* You cannot remove yourself: that is an instant loss of access to the page
                                   you are standing on. The server also refuses to delete the last account. *@
                                @if (account.Username != CurrentUser && accounts.Count > 1)
                                {
                                    <button class="link-danger" @onclick="() => DeleteAccount(account)">Remove</button>
                                }
                            </div>
                        }
                    </div>

                    <div class="account-add">
                        <input class="threshold-input wide" placeholder="username" @bind="newUsername" />
                        <input class="threshold-input wide" type="password" placeholder="password (8+)"
                               value="@newPassword" @oninput="OnNewPasswordInput" />
                        <button class="apply-btn" @onclick="AddAccount" disabled="@isSavingAccount">Add</button>
                    </div>

                    @if (accountMessage is not null)
                    {
                        <p class="save-message @(accountSuccess ? "success" : "error-msg")">@accountMessage</p>
                    }
                }
            </div>

            <div class="settings-footer">
                @if (saveMessage is not null)
                {
                    <span class="save-message @(saveSuccess ? "success" : "error-msg")">@saveMessage</span>
                }
                <button class="save-btn" @onclick="Save" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save changes")
                </button>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private List<AccountSummary>? accounts;
    private string? CurrentUser;
    private string newUsername = string.Empty;
    private string newPassword = string.Empty;
    private string? accountMessage;
    private bool accountSuccess;
    private bool isSavingAccount;

    private AppSettings? settings;
    private string? loadError;
    private string? saveMessage;
    private bool saveSuccess;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            CurrentUser = (await AuthState).User.Identity?.Name;
        }

        try
        {
            settings = await ApiClient.GetSettingsAsync();
            accounts = await AuthClient.ListUsersAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    private void OnNewPasswordInput(ChangeEventArgs e) =>
        newPassword = e.Value?.ToString() ?? string.Empty;

    private async Task AddAccount()
    {
        isSavingAccount = true;
        accountMessage = null;

        var problem = await AuthClient.CreateUserAsync(newUsername.Trim(), newPassword);

        isSavingAccount = false;
        accountSuccess = problem is null;
        accountMessage = problem ?? $"Account {newUsername.Trim()} created.";

        if (problem is null)
        {
            newUsername = string.Empty;
            newPassword = string.Empty;
            accounts = await AuthClient.ListUsersAsync();
        }
    }

    private async Task DeleteAccount(AccountSummary account)
    {
        var problem = await AuthClient.DeleteUserAsync(account.Id);

        accountSuccess = problem is null;
        accountMessage = problem ?? $"Account {account.Username} removed.";
        accounts = await AuthClient.ListUsersAsync();
    }

    private async Task Save()
    {
        if (settings is null) return;

        double[] thresholds =
        [
            settings.CpuThreshold, settings.MemoryThreshold, settings.DiskThreshold,
            settings.CpuWarningThreshold, settings.MemoryWarningThreshold, settings.DiskWarningThreshold
        ];

        if (thresholds.Any(threshold => threshold < 1 || threshold > 100))
        {
            saveMessage = "Thresholds must be between 1 and 100.";
            saveSuccess = false;
            return;
        }

        // The same rule the API enforces, checked here so the answer arrives before a round trip.
        if (settings.CpuWarningThreshold > settings.CpuThreshold ||
            settings.MemoryWarningThreshold > settings.MemoryThreshold ||
            settings.DiskWarningThreshold > settings.DiskThreshold)
        {
            saveMessage = "A warning threshold cannot be above its critical threshold.";
            saveSuccess = false;
            return;
        }

        if (settings.OfflineAfterMinutes < 1 || settings.OfflineAfterMinutes > 1440)
        {
            saveMessage = "The offline threshold must be between 1 minute and 24 hours.";
            saveSuccess = false;
            return;
        }

        isSaving = true;
        saveMessage = null;
        StateHasChanged();

        var ok = await ApiClient.UpdateSettingsAsync(settings);

        isSaving = false;
        saveSuccess = ok;
        saveMessage = ok ? "Settings saved successfully." : "Failed to save settings.";
    }
}