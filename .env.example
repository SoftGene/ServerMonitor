# Copy to .env and fill in. docker compose reads .env automatically.
# The .env file is gitignored; .env.example is not, so never put real values here.

# Database password.
POSTGRES_PASSWORD=change_me

# Shared token an agent presents once, on its first run, to receive its own key.
#   openssl rand -hex 32
ENROLLMENT_TOKEN=change_me

# Shared between the API and the web app: the API answers no read request without it.
#   openssl rand -hex 32
SERVICE_KEY=change_me

# Optional. Without them the bot stays quiet and alerts are still recorded in the journal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
