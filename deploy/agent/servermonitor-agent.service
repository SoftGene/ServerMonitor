# systemd unit for the ServerMonitor agent.
#
# Installed by deploy/agent/install.sh. Kept as a plain file rather than generated by the script,
# so it can be read, reviewed and changed like anything else in the repository.

[Unit]
Description=ServerMonitor agent
Documentation=https://github.com/SoftGene/ServerMonitor
# The agent retries on its own while the server is unreachable, so it needs the network stack to be
# up, not the server to be answering.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=servermonitor
Group=servermonitor

# The agent reads appsettings.json from its current directory, and writes agent-state.json and
# agent-buffer.json beside its binary. Without WorkingDirectory it would start in / and fail with
# "Agent:ServerUrl is not configured".
WorkingDirectory=/opt/servermonitor-agent
ExecStart=/opt/servermonitor-agent/ServerMonitor.Agent

# The server address and the enrollment token live in a separate file readable by root alone.
# systemd reads it before dropping privileges, so the token is neither in this unit — which any
# user may read — nor on a command line visible to everyone in ps.
EnvironmentFile=/etc/servermonitor-agent.env

# The agent formats nothing for people, so it needs no culture data; this spares a minimal server
# from having to install ICU just to start it.
Environment=DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1

Restart=always
RestartSec=10

# Exit status 78 (EX_CONFIG) is what the agent uses for a configuration it cannot work with: an
# enrollment token the server refuses, or none at all. Restarting fixes neither, so systemd stops
# trying, and `systemctl status` shows a failure instead of an endless loop of identical attempts.
RestartPreventExitStatus=78

# Hardening. The agent reads /proc and the size of the root filesystem, and writes its own
# directory. It needs nothing else, so it gets nothing else.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/servermonitor-agent

[Install]
WantedBy=multi-user.target
