<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!-- Pinned explicitly: a transitive dependency pulls in 10.0.4 and MSBuild resolves the
         conflict by choosing the older assembly, which is the wrong way round. The projects
         under test are built against 10.0.10. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServerMonitor.Infrastructure\ServerMonitor.Infrastructure.csproj" />
    <ProjectReference Include="..\ServerMonitor.Collection\ServerMonitor.Collection.csproj" />
    <ProjectReference Include="..\ServerMonitor.Agent\ServerMonitor.Agent.csproj" />
    <ProjectReference Include="..\ServerMonitor.Api\ServerMonitor.Api.csproj" />
    <!-- Aliased because both hosts compile a Program class out of their top-level
         statements, and referencing both makes the name ambiguous. The alias keeps the
         Web assembly out of the global namespace; the tests that need it say so. -->
    <ProjectReference Include="..\ServerMonitor.Web\ServerMonitor.Web.csproj" Aliases="WebApp" />
  </ItemGroup>

</Project>